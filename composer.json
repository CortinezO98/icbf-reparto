{
  "name": "iq/icbf-reparto",
  "description": "Modulo de reparto de peticiones ICBF",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-zip": "*",
    "vlucas/phpdotenv": "^5.6",
    "phpoffice/phpspreadsheet": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse app bin public --level=6",
    "lint": "find app bin public routes tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
