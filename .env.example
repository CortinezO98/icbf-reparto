APP_NAME="ICBF Reparto"
APP_ENV=local
APP_DEBUG=0
APP_URL=http://localhost:8088
APP_TIMEZONE=America/Bogota
APP_SESSION_NAME=ICBF_REPARTO
APP_SESSION_IDLE_MINUTES=30

DB_HOST=db
DB_PORT=3306
DB_DATABASE=icbf_reparto
DB_USERNAME=icbf_reparto
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD

LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
WORKER_INTERVAL_SECONDS=5
SLA_WORKER_INTERVAL_SECONDS=300